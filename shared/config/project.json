{
  "projectRoot": "/Users/wuyanzu/Desktop/FC",
  "timezone": "Asia/Shanghai",
  "dailyTime": "03:00",
  "sharedRoot": "shared",
  "runStatePattern": "automation/runs/{DATE}",
  "dailyOutputPattern": "reports/daily/{DATE}",
  "fixedLocalIndex": "daily-merged/index.html",
  "fixedPublicUrl": "https://fc27-site.app.workbuddy.host/",
  "consumers": ["WorkBuddy"],
  "publish": {
    "kind": "workbuddy-sites",
    "appName": "FC27每日情报台",
    "directory": "daily-merged",
    "entry": "index.html",
    "note": "每日任务在 coordinate.mjs 合并成功后，用 WorkBuddy 站点发布能力发布 daily-merged/；多文件站点，index.html + archive/ + assets/ 相对路径可用。"
  },
  "browser": {
    "required": "chrome-extension",
    "cliMode": "extension",
    "reuseLoggedInProfile": true,
    "forbidden": ["iab", "guest", "temporary-profile", "new-profile"]
  },
  "tasks": [
    { "order": 1, "id": "football", "name": "足球日报", "enabled": true, "output": "football.html" },
    { "order": 2, "id": "news", "name": "FC27资讯采集", "enabled": true, "output": "news.html" },
    { "order": 3, "id": "market", "name": "FC27市场扫描", "enabled": true, "output": "market.html" },
    { "order": 4, "id": "portal", "name": "汇总链接", "enabled": true, "output": "summary.html" }
  ]
}
