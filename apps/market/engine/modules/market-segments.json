{
  "currency": "coins",
  "platformDefault": "cross",
  "topN": 50,
  "outputs": [
    {
      "file": "reports/daily/D/market.html",
      "renderer": "scripts/render-market-overview.mjs",
      "tab": "市场概览",
      "sections": [
        { "id": "weekly", "name": "本周活动卡与本周周黑" },
        { "id": "price-tiers", "name": "价格分层（每档 Top 50，按 Rating 排序）" },
        { "id": "icons-heroes", "name": "传奇卡与英雄卡" },
        { "id": "evolutions", "name": "热门进化卡" }
      ]
    },
    {
      "file": "reports/daily/D/market-scan.html",
      "renderer": "scripts/render-market-report.mjs",
      "tab": "市场扫描",
      "sections": [
        { "id": "price", "name": "维度一 · 价格维度" },
        { "id": "popular", "name": "维度二 · 热门球员维度" }
      ]
    }
  ],
  "priceTiers": [
    {
      "id": "tier-1m",
      "name": "≥ 100 万",
      "min": 1000000,
      "maxExclusive": null,
      "futbinFilter": "pc_price=1000000%2B",
      "futbinUrl": "https://www.futbin.com/27/players?pc_price=1000000%2B"
    },
    {
      "id": "tier-300k",
      "name": "30 - 100 万",
      "min": 300000,
      "maxExclusive": 1000000,
      "futbinFilter": "pc_price=300000-1000000",
      "futbinUrl": "https://www.futbin.com/27/players?pc_price=300000-1000000"
    },
    {
      "id": "tier-100k",
      "name": "10 - 30 万",
      "min": 100000,
      "maxExclusive": 300000,
      "futbinFilter": "pc_price=100000-300000",
      "futbinUrl": "https://www.futbin.com/27/players?pc_price=100000-300000"
    },
    {
      "id": "tier-10k",
      "name": "1 - 10 万",
      "min": 10000,
      "maxExclusive": 100000,
      "futbinFilter": "pc_price=10000-100000",
      "futbinUrl": "https://www.futbin.com/27/players?pc_price=10000-100000"
    }
  ],
  "playersSource": {
    "url": "https://www.futbin.com/27/players",
    "sortKey": "Rating（页面 Rating 列，降序取前 50）",
    "note": "PC 平台用 pc_price，PlayStation 用 ps_price，两参数可叠加在同一 URL。"
  },
  "popularSource": {
    "url": "https://www.futbin.com/27/popular",
    "sortMetric": "FUTBIN 热门页显示的热度计数（非搜索热度）",
    "subgroups": [
      { "id": "popular-evolutions", "name": "热门进化卡", "source": "https://www.futbin.com/27/popular/evolutions" },
      { "id": "value", "name": "价值卡", "source": "https://www.futbin.com/27/popular", "note": "热门榜中的非进化卡" }
    ]
  },
  "renderers": {
    "all": "scripts/render-market.mjs",
    "overview": "scripts/render-market-overview.mjs",
    "scan": "scripts/render-market-report.mjs"
  },
  "dataFile": "automation/runs/D/market/market.json"
}
